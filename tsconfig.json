{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // Ported sof-mssql modules that still depend on the mssql driver. Each is
    // re-included as it is ported to Oracle (tasks T015-T032).
    "src/loader/**",
    "src/tests/**",
    "src/load.ts",
    "src/cli.ts"
  ]
}
