{
  "name": "sof-oracle",
  "version": "0.1.0",
  "description": "A SQL on FHIR view runner that transpiles view definitions into SQL queries for Oracle Database",
  "author": "Australian e-Health Research Centre, CSIRO",
  "contributors": [
    {
      "name": "John Grimes",
      "email": "John.Grimes@csiro.au",
      "url": "https://people.csiro.au/G/J/john-grimes"
    }
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sof-oracle": "./dist/cli.js"
  },
  "scripts": {
    "antlr": "node scripts/antlr.mjs",
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "cli:load": "tsx src/cli.ts load",
    "cli:transpile": "tsx src/cli.ts transpile",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:duplication": "bunx jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "fhir",
    "sql-on-fhir",
    "oracle",
    "oracle-database",
    "healthcare"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aehrc/sof-oracle.git"
  },
  "homepage": "https://github.com/aehrc/sof-oracle#readme",
  "bugs": {
    "url": "https://github.com/aehrc/sof-oracle/issues"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "commander": "^14.0.1",
    "fhirpath": "^3.15.1",
    "oracledb": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.5.5",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^3.2.4",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "eslint": "^9.11.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "eslint-plugin-unicorn": "^65",
    "jscpd": "^5.2.0",
    "lossless-json": "^4.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
